{
  "expo": {
    "name": "Goose On The Go",
    "slug": "goose-on-the-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/GooseOnTheGoAppIcons/GooseInAPond-iOS-Default-1024@1x.png",
    "scheme": "gooseonthego",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.jarida.gooseonthego",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Goose On The Go looks for your Goose In A Pond server on this network so you do not have to type its address.",
        "NSBonjourServices": [
          "_pond._tcp"
        ]
      },
      "appleTeamId": "5J6QNMRQQR",
      "icon": {
        "light": "./assets/GooseOnTheGoAppIcons/GooseInAPond-iOS-Default-1024@1x.png",
        "dark": "./assets/GooseOnTheGoAppIcons/GooseInAPond-iOS-Dark-1024@1x.png",
        "tinted": "./assets/GooseOnTheGoAppIcons/GooseInAPond-iOS-TintedDark-1024@1x.png"
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.jarida.gooseonthego",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Goose On The Go uses your camera to scan QR codes, such as your Pond's pairing code and the setup code on a device you are adding, and to take photos you choose to send to Goose.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1E",
          "dark": {
            "backgroundColor": "#1C1C1E"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Goose On The Go uses the microphone when you talk to Goose. What you say goes to your own Pond, nowhere else."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Goose On The Go opens your photos so you can choose pictures to send to Goose.",
          "cameraPermission": "Goose On The Go uses your camera to scan QR codes, such as your Pond's pairing code and the setup code on a device you are adding, and to take photos you choose to send to Goose.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-pond-tls",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
