# Expo SDK 56: expo-router no longer bundles react-navigation, but this app
# still uses a couple of @react-navigation primitives (ThemeProvider,
# PlatformPressable). This flag disables expo-router's hard incompatibility
# guard so Metro bundles. Transitional — remove once those usages are migrated
# to expo-router equivalents. See docs.expo.dev/router/migrate/sdk-55-to-56/.
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
